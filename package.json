{
  "name": "neumalab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verificar": "tsc --noEmit && vitest run",
    "e2e": "node e2e/humo.mjs",
    "entregables": "vite-node scripts/entregables.ts",
    "respaldo-mecbot": "node --env-file-if-exists=.env scripts/respaldo-mecbot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "express": "^4.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-viewport-gizmo": "^2.2.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
