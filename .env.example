# Clave del modelo de MecBot. No la subas al repositorio.
# En Vercel: Settings → Environment Variables → MEC_BOT_API_KEY
# Para probar: una clave gratis de Groq en https://console.groq.com/keys
MEC_BOT_API_KEY=

# Opcional. Si no se ponen, MecBot usa Groq y llama-3.3-70b-versatile.
# MEC_BOT_URL=https://api.groq.com/openai/v1/chat/completions
# MEC_BOT_MODELO=llama-3.3-70b-versatile
