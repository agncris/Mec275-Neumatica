# Clave del modelo de MecBot. No la subas al repositorio.
# En Vercel: Settings → Environment Variables → MEC_BOT_API_KEY
# Para probar: una clave gratis de Groq en https://console.groq.com/keys
MEC_BOT_API_KEY=

# Opcional. Si no se ponen, MecBot usa Groq y openai/gpt-oss-120b.
# MEC_BOT_URL=https://api.groq.com/openai/v1/chat/completions
# MEC_BOT_MODELO=openai/gpt-oss-120b

# Opcional. Clave de Claude (consola de Anthropic, crédito de API aparte de la suscripción).
# Si está, MecBot usa Claude y Groq queda de respaldo si Claude falla.
# MEC_BOT_CLAUDE_API_KEY=
# MEC_BOT_CLAUDE_MODELO=claude-sonnet-5-5

# Opcional. Tope de preguntas por IP (por defecto 12 por hora y 40 por día). 0 quita el tope.
# MEC_BOT_TOPE_HORA=0
# MEC_BOT_TOPE_DIA=0

# Opcional, solo en local. Guarda cada pregunta y respuesta en este archivo (una línea JSON).
# MEC_BOT_REGISTRO=registro-mecbot.jsonl
